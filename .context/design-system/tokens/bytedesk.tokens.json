  "material": {
    "$description": "Black Glass + Optical Layering primitives. Structural material only; do not apply every level to every component.",
    "blur-shell": { "$type": "dimension", "$value": "18px" },
    "blur-overlay": { "$type": "dimension", "$value": "24px" },
    "shell-opacity-dark": { "$type": "number", "$value": 0.94 },
    "shell-opacity-light": { "$type": "number", "$value": 0.97 },
    "top-light-dark": { "$type": "color", "$value": "#FFFFFF0A" },
    "top-light-light": { "$type": "color", "$value": "#FFFFFFCC" },
    "ambient-blue": { "$type": "color", "$value": "#07182E66" },
    "ambient-orange": { "$type": "color", "$value": "#EC4E0238" }
  },
  "depth": {
    "$description": "Optical elevation strings map directly to CSS box-shadow and equivalent native shadow structures.",
    "shell-dark": { "$type": "string", "$value": "inset 0 1px 0 #FFFFFF0A, 0 24px 56px #05080DB8, 0 8px 20px #07182E66" },
    "shell-light": { "$type": "string", "$value": "inset 0 1px 0 #FFFFFFCC, 0 24px 56px #17203324, 0 8px 20px #315B9B14" },
    "raised-dark": { "$type": "string", "$value": "inset 0 1px 0 #FFFFFF08, 0 8px 20px #05080D66" },
    "raised-light": { "$type": "string", "$value": "inset 0 1px 0 #FFFFFFE6, 0 8px 20px #17203317" },
    "focus-glow": { "$type": "string", "$value": "0 0 0 1px #1B84F3, 0 0 24px #1B84F34D" },
    "attention-glow": { "$type": "string", "$value": "0 0 20px #EC4E0238" }
  },
