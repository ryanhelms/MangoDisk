      "shell": { "$type": "color", "$value": "#171A1D" },
      "inset": { "$type": "color", "$value": "#14171A" },
      "raised": { "$type": "color", "$value": "#1D2125" },
      "overlay": { "$type": "color", "$value": "#24282D" },
