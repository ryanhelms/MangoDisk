      "ink-tertiary": { "$type": "color", "$value": "#7E8792" },
      "border-subtle": { "$type": "color", "$value": "#272A2C" },
      "border-default": { "$type": "color", "$value": "#3A3E42" },
      "border-strong": { "$type": "color", "$value": "#4C4F52" }
    },
    "light": {
